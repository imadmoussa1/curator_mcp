# Firebase Admin Credentials
FIREBASE_CREDENTIALS_PATH=./service-account.json

# Optional: Port configuration if running MCP server over HTTP/SSE
PORT=8000

# External APIs for Book & Media Recommendations
# 1. Google Books API (Optional: basic search works without a key, or provide a Google Cloud API key for higher rate limits)
GOOGLE_BOOKS_API_KEY=

# 2. The Movie Database (TMDB) API Key (Free: get one at https://www.themoviedb.org/settings/api)
# Can be your v3 API Key or v4 Read Access Token
TMDB_API_KEY=
